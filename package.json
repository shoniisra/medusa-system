    "react": "^18.3.1",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.9",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.11",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
