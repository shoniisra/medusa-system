{
  "name": "medusa-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Medusa Estudio — SaaS multi-sucursal de gestión de salones (frontend PWA)",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "preview": "vite preview",
