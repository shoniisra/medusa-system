# Turso / libSQL
# ADVERTENCIA: exponer el token en el frontend permite a cualquiera con acceso
# al bundle leer/escribir la BDD. Para producción, poné un backend/proxy o usa
# tokens de solo lectura con alcance limitado. Esto sirve para el MVP.
VITE_TURSO_DATABASE_URL=libsql://medusabdd-tamecsoftware.aws-us-east-1.turso.io
VITE_TURSO_AUTH_TOKEN=

# Organización por defecto (multi-tenant). Se puede sobreescribir tras login.
VITE_DEFAULT_ORG_ID=

# Google Calendar (opcional). Client ID OAuth 2.0 (tipo "Aplicación web") de un
# proyecto de Google Cloud con "Google Calendar API" habilitada. Si se deja
# vacío, la sincronización de citas con Google queda desactivada.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_SECRET=