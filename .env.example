# Turso / libSQL — SOLO DESARROLLO LOCAL (npm run dev).
# En dev, db.ts se conecta directo a Turso con estas variables (conserva HMR).
# En PRODUCCIÓN el token NO va acá ni en las Build variables de Cloudflare: va
# como secret del Worker. Cargalo una sola vez con:
#   npx wrangler secret put TURSO_DATABASE_URL
#   npx wrangler secret put TURSO_AUTH_TOKEN
# El Worker (worker/index.ts) expone el proxy en POST /api/db; el bundle del
# navegador nunca contiene el token.
VITE_TURSO_DATABASE_URL=libsql://medusabdd-tamecsoftware.aws-us-east-1.turso.io
VITE_TURSO_AUTH_TOKEN=

# Organización por defecto (multi-tenant). Se puede sobreescribir tras login.
VITE_DEFAULT_ORG_ID=

# Google Calendar — service account (sistema → Google).
# El sistema escribe en los calendarios del salón con una service account del
# lado del servidor: NADIE inicia sesión en Google desde la app (el único login
# es Cloudflare Access). Del JSON que descargás de Google Cloud:
#   GCAL_SA_EMAIL       = client_email
#   GCAL_SA_PRIVATE_KEY = private_key (PEM completo; en una línea con \n)
# Van SIN prefijo VITE_ a propósito: así la clave privada no entra al bundle.
# En PRODUCCIÓN no van acá, van como secrets del Worker:
#   jq -r .client_email  clave.json | npx wrangler secret put GCAL_SA_EMAIL
#   jq -r .private_key   clave.json | npx wrangler secret put GCAL_SA_PRIVATE_KEY
# Además, cada calendario de sucursal tiene que estar compartido con
# GCAL_SA_EMAIL con permiso "Hacer cambios en los eventos", y su ID guardado en
# branch.google_calendar_id (la service account no tiene calendario "primary").
GCAL_SA_EMAIL=
GCAL_SA_PRIVATE_KEY=
